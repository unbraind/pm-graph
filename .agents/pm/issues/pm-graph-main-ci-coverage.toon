  "npm run release:check",project,3600,codex-agent,"2026-10-30T14:24:32.306Z",local_mutation,fix/main-ci-red-1029
  "bun run release:check",project,3600,codex-agent,"2026-10-30T14:24:32.306Z",local_mutation,fix/main-ci-red-1029
