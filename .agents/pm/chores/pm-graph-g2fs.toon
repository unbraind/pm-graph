tests[1]{command,path,scope}:
  PM_PATH=/tmp/pm-mv-pm-graph PM_GLOBAL_PATH=/tmp/pm-mv-g-pm-graph node --test test/manifest-vocabulary.test.ts,test/manifest-vocabulary.test.ts,project
close_reason: "Removed the inert pm key from manifest.json; pinned @unbrained/pm-cli at 2026.8.22; added unbounded output-budget args to changelog scripts; regression test manifest-vocabulary.test.ts verified to fail on re-add and pass after removal; npm test 222/222, release:check exit 0, pinned pm health --strict-exit exit 0."
