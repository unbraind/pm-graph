{"hash_algorithm":"sha256","ts":"2026-11-03T10:48:27.822Z","author":"pi-toolchain-glm-1103","author_source":"asserted","agent_harness":"pi","agent_model":"glm-5.3:cloud","agent_model_source":"environment","agent_instance":"9e1c18dd119f0404d66458ad","agent_provenance":{"model":{"value":"glm-5.3:cloud","source":"environment"},"effort":null,"role":{"value":"implementer","source":"argv"},"topic":null},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"pm-graph-33oc"},{"op":"add","path":"/metadata/title","value":"Drop the deprecated pm-github-version input so Dependabot workflow bumps pass"},{"op":"add","path":"/metadata/description","value":"The install-pm-github test required the deprecated pm-github-version input to equal the pinned release comment on the sync caller. Dependabot rewrites only the commit SHA and its release comment, so every pm-github workflow repin failed the test and the input could only be fixed by hand. The pinned release commit is now the only version source: both caller workflows pin their reusable workflows without the input, and the test asserts the input stays absent while keeping every other assertion (pin SHA with release annotation, schedule, dispatch, permissions, no inline steps). Mirrors the same change made in pm-web."},{"op":"add","path":"/metadata/type","value":"Chore"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":2},{"op":"add","path":"/metadata/tags","value":["ci","dependencies","gh:unbraind/pm-graph#190","pm-github"]},{"op":"add","path":"/metadata/created_at","value":"2026-11-03T10:48:27.822Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-11-03T10:48:27.822Z"},{"op":"add","path":"/metadata/author","value":"pi-toolchain-glm-1103"}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"4d571bff4b6e866d00fcbf0fc6abbf70bd4c87e6ed121df911e5e7ec590b5bfc","item_hash_version":3,"message":"","event_class":"substantive","record_hash_version":1,"record_hash":"e9c2da399d86c0ece18c3934008c14a5b75e064d3e233b9dc47314b918932c3b"}
