{"ts":"2026-08-03T22:03:05.195Z","author":"pi-agent","author_source":"asserted","agent_harness":"pi","agent_model":"kimi-k3","agent_model_source":"environment","agent_instance":"14f4ca93bbfb1347ba988088","agent_provenance":{"model":{"value":"kimi-k3","source":"environment"},"effort":null,"role":null,"topic":null},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"pm-graph-l9df"},{"op":"add","path":"/metadata/title","value":"Fix runGraph projected result narrowing and bump pm-cli to 2026.8.3"},{"op":"add","path":"/metadata/description","value":"pm-cli 2026.8.3 changed the SDK runGraph return type from GraphResult to ProjectedGraphResult (GraphResult plus an output projection declaration). The generic wrapper runPmGraph in src/index.ts casts that to an unresolved type parameter T, which fails typecheck with TS2352. Fix: remove the type parameter, return the projected result, and narrow on the subcommand discriminant at the single impact call site with a CommandError guard. Also bump the pm-cli pin to 2026.8.3 in devDependencies and peerDependencies with a committed lockfile refresh. Supersedes dependabot PR 51."},{"op":"add","path":"/metadata/type","value":"Issue"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":2},{"op":"add","path":"/metadata/tags","value":[]},{"op":"add","path":"/metadata/created_at","value":"2026-08-03T22:03:05.195Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-08-03T22:03:05.195Z"},{"op":"add","path":"/metadata/author","value":"pi-agent"},{"op":"add","path":"/metadata/acceptance_criteria","value":"npm run typecheck, build, test, coverage, and changelog:check all pass; no cast or any introduced; pin at 2026.8.3 in package.json and package-lock.json"}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"738f05acf48bba8aa57b00e582857ff1ebedcf195ad51b9e5eff0661f6fe3b1f","message":""}
