node_modules/
# dist/ is intentionally committed: a git-URL install copies the repo as-is
# and never runs a build, so the entry file must be in git.
dist-test/
npm-debug.log*
.DS_Store
*.tgz
RELEASE_NOTES.md
# The managed project extension registry is tracked; package artifacts are restored by the workflow.
.agents/pm/extensions/*
!.agents/pm/extensions/.managed-extensions.json
.agents/pm/locks/
.agents/pm/runtime/
.agents/pm/search/

# SDK workspace-transaction journals are runtime state and must not be tracked.
.agents/pm/transactions/

# Local environment
.env
.env.*
!.env.example
coverage/
